# Local backend database (docker-compose overrides this to host "postgres").
DATABASE_URL=postgresql://pde:pde@localhost:5432/pde

# Optional direct (non-pooled) connection used only for schema migrations.
# MIGRATION_DATABASE_URL=postgresql://pde:pde@localhost:5432/pde

# "groq", "openai", or "ollama"
LLM_STRATEGY=groq
# "gemini", "openai", or "ollama"
EMBEDDING_STRATEGY=gemini

GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
# The free-tier output-tokens-per-minute limit depends on the model.
GROQ_MAX_OUTPUT_TOKENS=4096

# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY is accepted as a fallback for GOOGLE_API_KEY.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Use http://localhost:11434 when the backend runs on the host instead of Docker.
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=bge-m3

CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=3
# Hard cap on retrieved context sent to the LLM, in characters.
MAX_CONTEXT_CHARS=6000

VERIFIER_URL=http://localhost:8000
# Local development only. The production Docker build defaults to
# https://pde-rag.onrender.com (see the root Dockerfile).
VITE_API_URL=http://localhost:3000
EVAL_API_URL=http://localhost:3000
